<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@android:color/darker_gray">

        <Button
            android:id="@+id/btn_vip_crown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👑"
            android:backgroundTint="@android:color/transparent" />

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:hint="Search tools..." />

        <Button
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:backgroundTint="@android:color/transparent" />

        <Button
            android:id="@+id/btn_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:backgroundTint="@android:color/transparent" />
    </LinearLayout>

    <!-- Main Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Home View -->
        <ScrollView
            android:id="@+id/view_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Hero Banner -->
                <Button
                    android:id="@+id/hero_tools_banner"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:text="🪐 All Tools"
                    android:textSize="20sp"
                    android:layout_marginBottom="16dp" />

                <!-- Folders Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/folder_ai"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:text="🤖 AI"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/folder_offline"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:text="📶 Offline"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/folder_privacy"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:text="🎭 Privacy"
                        android:layout_margin="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/folder_savers"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:text="📥 Savers"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/folder_office"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:text="📑 Office"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/folder_desi"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:text="₹ Desi"
                        android:layout_margin="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/folder_media"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:text="🎵 Media"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/folder_system"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:text="⚡ Boost"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/folder_pro"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:text="🪐 Pro"
                        android:layout_margin="4dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_view_all"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View All Tools"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Subfolders View -->
        <LinearLayout
            android:id="@+id/view_subfolders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_back_to_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="← Back" />

                <TextView
                    android:id="@+id/subfolder_main_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Category"
                    android:textSize="18sp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/subfolder_items_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Tool Workspace View -->
        <LinearLayout
            android:id="@+id/view_tool_workspace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_back_to_subfolders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="← Back" />

                <TextView
                    android:id="@+id/tool_active_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tool"
                    android:textSize="16sp"
                    android:gravity="center" />
            </LinearLayout>

            <TextView
                android:id="@+id/tool_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/tool_input_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter input"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btn_run_tool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Run Tool"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tool_output_box"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="Output"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:background="@android:color/darker_gray" />
        </LinearLayout>

        <!-- Other Screen -->
        <TextView
            android:id="@+id/other_screen_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="20sp"
            android:visibility="gone" />

        <!-- Emergency Study Layer -->
        <FrameLayout
            android:id="@+id/emergency_study_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📚 Study Mode Active"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/btn_close_emergency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Close"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_menu" />

    <!-- FAB Panic Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_panic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_dialog_alert" />
</LinearLayout>
