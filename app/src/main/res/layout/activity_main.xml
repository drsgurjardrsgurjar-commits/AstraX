<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_bg">

    <!-- Screen Content Container -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation">

        <!-- Include Rich AstraX Home Screen -->
        <include
            android:id="@+id/layout_home_screen"
            layout="@layout/fragment_home" />

        <!-- Simple Text for Other Tabs -->
        <TextView
            android:id="@+id/other_screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 5 Navigation Tabs -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/card_bg"
        app:itemIconTint="@color/text_white"
        app:itemTextColor="@color/text_white"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

    <!-- Floating Panic Switch (Stealth Trigger) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_panic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/bottom_navigation"
        android:layout_margin="16dp"
        android:alpha="0.6"
        android:src="@drawable/ic_panic"
        app:backgroundTint="#FF4757"
        app:tint="@color/text_white"
        app:fabSize="mini" />

    <!-- Emergency Study Mode Layer (Full-Screen NCERT Notes) -->
    <LinearLayout
        android:id="@+id/emergency_study_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Top Bar with Safe Close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Class 12 Physics - Quick Notes"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_close_emergency"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:text="Back"
                android:textSize="12sp"
                android:backgroundTint="#2C3E50" />
        </RelativeLayout>

        <!-- Scrollable Realistic Physics Notes -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chapter 4: Moving Charges and Magnetism&#10;&#10;1. Biot-Savart Law:&#10;The magnetic field dB due to a current element carrying steady current I at point P is:&#10;dB = (mu0 / 4pi) * (I dl sin theta) / r2&#10;&#10;2. Ampere Circuital Law:&#10;The line integral of magnetic induction around any closed path is:&#10;B . dl = mu0 * I&#10;&#10;3. Lorentz Force:&#10;When a charge q moves with velocity v in electric and magnetic fields:&#10;F = q(E + v x B)&#10;&#10;Chapter 5: Thermodynamics and Heat Laws&#10;&#10;1. First Law of Thermodynamics:&#10;dQ = dU + dW&#10;where dQ is heat supplied, dU is change in internal energy, and dW is work done.&#10;&#10;2. Isothermal Process:&#10;Temperature remains constant (dT = 0). Internal energy change dU = 0.&#10;W = nRT ln(V2/V1)&#10;&#10;3. Adiabatic Process:&#10;No heat enters or leaves the system (dQ = 0).&#10;PV^gamma = Constant"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:lineSpacingExtra="6dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</RelativeLayout>
